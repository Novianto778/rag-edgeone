# ── EdgeOne Pages Blob Storage ──
BLOB_STORE_NAME=uploads

# ── EdgeOne Makers LLM Gateway ──
AI_GATEWAY_API_KEY=your_edgeone_makers_api_key
AI_GATEWAY_BASE_URL=https://ai-gateway.edgeone.link/v1
AI_GATEWAY_MODEL=@makers/deepseek-v4-flash

# ── Qdrant Cloud Vector Database ──
QDRANT_URL=https://your-qdrant-cluster.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key
QDRANT_COLLECTION=hr_rag_knowledge_base

# ── Firecrawl Markdown Parser API ──
FIRECRAWL_API_KEY=fc-xxxxxxxxxxxxxxxx

# ── Mistral Dense Embedding API (Optional) ──
MISTRAL_API_KEY=mistral-xxxxxxxxxxxxxxxx

# ── Voyage AI Rerank API (Optional) ──
VOYAGE_API_KEY=pa-xxxxxxxxxxxxxxxx
